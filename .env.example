# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=
# 応答に使うモデルと思考の深さ（速さ重視なら low）
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# VOICEVOX エンジンのURLと話者ID（起動していなければ音声なしで動作）
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=1
# サーバーの待ち受けポート
PORT=8787
# 配信中に顔のレビューを自動で行う間隔（時間）。0 で無効
FACE_REVIEW_HOURS=3
