# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=
# 応答に使うモデルと思考の深さ（速さ重視なら low）
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# VOICEVOX エンジンのURLと話者ID（起動していなければ音声なしで動作）
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=1
# サーバーの待ち受けポート
PORT=8787
# 新しい衣装・髪型を AI が企画して作る間隔（配信時間・分）
DESIGN_INTERVAL_MINUTES=240
# 形の変更が必要な衣装・髪型を作る外部コマンド（任意）。指示書 JSON を標準入力で受け取り、最後の行に VRM のパスを出力する
MODEL_GENERATOR_CMD=

# ---- YouTube（任意）----
# かんたん: API キーと配信の動画 ID（またはチャンネル ID）でチャットと同時視聴者数を読む
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
YOUTUBE_CHANNEL_ID=
# おすすめ: OAuth。自分のライブ配信を自動で見つけ、配信後の視聴維持率も使う（npm run youtube-auth -w server で取得）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# チャットを読む最短間隔（ミリ秒）。API の1日の上限（10,000ユニット）に収まるよう 10 秒が既定
YOUTUBE_CHAT_POLL_MS=10000
